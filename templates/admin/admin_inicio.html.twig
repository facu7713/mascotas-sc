{% extends 'base_admin.html.twig' %}

{% block title %}
    Inicio Administrador | Mascotas SC
{% endblock %}

{% block contenido %}

    <div class="row justify-content-center">

        <div class="col-lg-10 col-xl-9 text-center">

            <h1 class="display-5 fw-bold mb-4">
                ¡Bienvenido/a al panel de administración!
            </h1>

            <img
                src="{{ asset('imagenes_pagina/logo-escritorio.png') }}"
                class="img-fluid mb-4"
                width="450"
                alt="Mascotas SC">

            <p class="lead">
                Desde este espacio podrás administrar y supervisar el funcionamiento
                de Mascotas SC, gestionar la información de las mascotas y sus
                propietarios, controlar las actividades de los voluntarios y
                mantener actualizada la información de la plataforma.
            </p>

            <p class="text-muted fs-5">
                Tu tarea es fundamental para garantizar que la información se
                encuentre organizada, que los registros sean confiables y que
                las herramientas del sistema contribuyan al bienestar animal
                y a la colaboración de toda la comunidad.
            </p>

            <p class="fst-italic text-secondary mt-4">
                "Una buena gestión también es una forma de cuidar y proteger."
            </p>

            <hr class="my-5">

            <div class="row g-4">

                <div class="col-md-6">

                    <div class="card h-100 shadow-sm border-0">

                        <div class="card-body">

                            <i class="bi bi-paw fs-1 text-primary"></i>

                            <h4 class="mt-3">
                                Gestión de mascotas
                            </h4>

                            <p class="text-muted">
                                Consultá y administrá los registros de mascotas
                                y sus respectivas tarjetas de identificación.
                            </p>

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="card h-100 shadow-sm border-0">

                        <div class="card-body">

                            <i class="bi bi-people fs-1 text-success"></i>

                            <h4 class="mt-3">
                                Propietarios y usuarios
                            </h4>

                            <p class="text-muted">
                                Consultá la información de las personas registradas
                                y gestioná las cuentas de la plataforma.
                            </p>

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="card h-100 shadow-sm border-0">

                        <div class="card-body">

                            <i class="bi bi-person-check fs-1 text-info"></i>

                            <h4 class="mt-3">
                                Gestión de voluntarios
                            </h4>

                            <p class="text-muted">
                                Revisá las postulaciones y administrá la participación
                                de los voluntarios en el sistema.
                            </p>

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="card h-100 shadow-sm border-0">

                        <div class="card-body">

                            <i class="bi bi-eyedropper fs-1 text-danger"></i>

                            <h4 class="mt-3">
                                Vacunas y campañas
                            </h4>

                            <p class="text-muted">
                                Supervisá los registros de vacunación y gestioná
                                los anuncios de campañas para la comunidad.
                            </p>

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="card h-100 shadow-sm border-0">

                        <div class="card-body">

                            <i class="bi bi-clipboard-data fs-1 text-warning"></i>

                            <h4 class="mt-3">
                                Reportes
                            </h4>

                            <p class="text-muted">
                                Consultá la información y los reportes del sistema
                                para facilitar el seguimiento de las actividades.
                            </p>

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="card h-100 shadow-sm border-0">

                        <div class="card-body">

                            <i class="bi bi-gear fs-1 text-secondary"></i>

                            <h4 class="mt-3">
                                Administración del sistema
                            </h4>

                            <p class="text-muted">
                                Mantené organizada la plataforma y supervisá
                                el correcto funcionamiento de sus funcionalidades.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

{% endblock %}
