{% extends 'base_particular.html.twig' %}

{% block title %}
    Vacunación | Mascotas SC
{% endblock %}

{% block contenido %}

    <div class="container py-4">

        <a href="{{ path('app_tarjeta_id') }}"
            class="btn btn-primary">
                <i class="bi bi-arrow-left me-2"></i>
                Volver
        </a>

        <div class="text-center mb-4">

            <i class="bi bi-heart-pulse text-primary"
                style="font-size: 3rem;">
            </i>

            <h2 class="fw-bold mt-2">
                Vacunación
            </h2>

            <p class="text-muted">
                Registro de vacunas de tu mascota.
            </p>

        </div>


        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div>
                        <h4 class="fw-bold mb-1">
                            Vacunas registradas
                        </h4>

                        <p class="text-muted mb-0">
                            Aquí podrás consultar las vacunas de tu mascota.
                        </p>
                    </div>

                </div>


                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Vacuna</th>
                                <th>Fecha de aplicación</th>
                                <th>Veterinario</th>
                            </tr>

                        </thead>

                        <tbody>

                            {% if vacunas|length > 0 %}

                                {% for vacuna in vacunas %}

                                    <tr>

                                        <td>
                                            {{ vacuna.tipoVacuna }}
                                        </td>

                                        <td>
                                            {{ vacuna.fechaAplicacion|date('d/m/Y') }}
                                        </td>

                                        <td>
                                            {{ vacuna.veterinario }}
                                        </td>

                                    </tr>

                                {% endfor %}

                            {% else %}

                                <tr>

                                    <td colspan="4"
                                        class="text-center text-muted py-5">

                                        <i class="bi bi-shield-plus"
                                        style="font-size: 3rem;">
                                        </i>

                                        <p class="mt-3 mb-0">
                                            Todavía no hay vacunas registradas.
                                        </p>

                                    </td>

                                </tr>

                            {% endif %}

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

{% endblock %}