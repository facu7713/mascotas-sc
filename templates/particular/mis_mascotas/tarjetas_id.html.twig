{% extends 'base_particular.html.twig' %}

{% block title %}
    Mis Mascotas | Mascotas SC
{% endblock %}

{% block contenido %}

    <div class="container py-4">

        <h1 class="text-center fw-bold mb-4">
            Mis Mascotas
        </h1>

        {% for message in app.flashes('success') %}

            <div class="alert alert-success alert-dismissible fade show text-center" role="alert">

                <i class="bi bi-bookmark-check"></i>

                    {{ message }}

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Cerrar">
                    </button>

            </div>

        {% endfor %}

        {% for message in app.flashes('warning') %}

            <div class="alert alert-warning text-center">
                <i class="bi bi-exclamation-circle"></i>
                {{ message }}
            </div>

        {% endfor %}


        {% if mascotas is not empty %}

            <div class="row justify-content-center">

                {% for mascota in mascotas %}

                    <div class="col-12 col-xl-6 mb-4">

                        <div class="card shadow border-0 rounded-4">

                            <!-- CABECERA -->

                            <div class="card-header bg-white border-0
                                        d-flex justify-content-between
                                        align-items-center
                                        px-4 py-3">

                                <h3 class="fw-bold mb-0">
                                    {{ mascota.nombre }}
                                </h3>

                                <span class="badge bg-primary fs-6">
                                    TARJETA ID: {{ mascota.tarjetaId.id }}
                                </span>

                            </div>


                            <div class="card-body">

                                <div class="row g-4 align-items-center">

                                    <!-- FOTO -->

                                    <div class="col-12 col-md-5 text-center">

                                        {% if mascota.foto %}

                                            <img
                                                src="{{ asset(mascota.foto) }}"
                                                alt="Foto de {{ mascota.nombre }}"
                                                class="img-fluid rounded-4 shadow-sm"
                                                style="
                                                    width: 100%;
                                                    max-width: 250px;
                                                    height: 200px;
                                                    object-fit: cover;
                                                "
                                            >

                                        {% else %}

                                            <div
                                                class="bg-light rounded-4 d-flex
                                                    justify-content-center
                                                    align-items-center mx-auto"
                                                style="
                                                    width: 100%;
                                                    max-width: 320px;
                                                    height: 300px;
                                                "
                                            >

                                                <i class="bi bi-image fs-1 text-secondary"></i>

                                            </div>

                                        {% endif %}

                                    </div>


                                    <!-- DATOS -->

                                    <div class="col-12 col-md-7">

                                        <div class="row g-3">

                                            <div class="col-12 col-sm-6">

                                                <strong>Nombre:</strong>

                                                <div class="form-control bg-light">
                                                    {{ mascota.nombre }}
                                                </div>

                                            </div>


                                            <div class="col-12 col-sm-6">

                                                <strong>Color:</strong>

                                                <div class="form-control bg-light">
                                                    {{ mascota.color }}
                                                </div>

                                            </div>


                                            <div class="col-12 col-sm-6">

                                                <strong>Género:</strong>

                                                <div class="form-control bg-light">
                                                    {{ mascota.genero }}
                                                </div>

                                            </div>


                                            <div class="col-12 col-sm-6">

                                                <strong>Estado:</strong>

                                                <div class="form-control bg-light">
                                                    {{ mascota.estado }}
                                                </div>

                                            </div>


                                            <div class="col-12 col-sm-6">

                                                <strong>Tipo:</strong>

                                                <div class="form-control bg-light">
                                                    {{ mascota.tipo }}
                                                </div>

                                            </div>


                                            <div class="col-12 col-sm-6">

                                                <strong>Emisión:</strong>

                                                <div class="form-control bg-light">

                                                    {{ mascota.tarjetaId.fechaEmision|date('d/m/Y') }}

                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- BOTONES -->

                            <div class="card-footer bg-white border-0 px-4 pb-4">

                                <div class="row g-2">

                                    <div class="col-12 col-md-6">

                                        <a
                                            href="#"
                                            class="btn btn-primary w-100"
                                        >
                                            <i class="bi bi-file-earmark-pdf"></i>
                                            PDF
                                        </a>

                                    </div>


                                    <div class="col-12 col-md-6">

                                        <a
                                            href="#"
                                            class="btn btn-warning w-100"
                                        >
                                            <i class="bi bi-pencil-square"></i>
                                            Actualizar
                                        </a>

                                    </div>


                                    <div class="col-12 col-md-6">

                                        <a
                                            href="#"
                                            class="btn btn-success w-100"
                                        >
                                            <i class="bi bi-prescription2"></i>
                                            Vacunación
                                        </a>

                                    </div>


                                    <div class="col-12 col-md-6">

                                        <a
                                            href="#"
                                            class="btn btn-outline-danger w-100"
                                        >
                                            <i class="bi bi-exclamation-triangle"></i>
                                            Reportar
                                        </a>

                                    </div>


                                    <div class="col-12">

                                        <a
                                            href="#"
                                            class="btn btn-danger w-100"
                                        >
                                            <i class="bi bi-trash"></i>
                                            Eliminar tarjeta ID
                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                {% endfor %}

            </div>

        {% endif %}

    </div>

{% endblock %}