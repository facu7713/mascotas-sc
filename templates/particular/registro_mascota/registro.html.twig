{% extends 'base_particular.html.twig' %}

{% block title %}
Registrar tu Mascota | Mascotas SC
{% endblock %}

{% block contenido %}

    <section class="bg-light align-items-center">

        <div class="container my-4">
            
            <div class="card shadow-lg border-0 rounded-4 p-4">

                {% for message in app.flashes('success') %}

                    <div class="alert alert-success alert-dismissible fade show text-center" role="alert">

                        <i class="bi bi-bookmark-check"></i>

                        {{ message }}

                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Cerrar">
                        </button>

                    </div>

                {% endfor %}

                <h1 class="text-center mb-4">
                    Registrar Tu Mascota
                </h1>

                <p class="text-center mb-4">
                    Completa los datos para registrar a tu mascota en el Sistema de Registro de Mascotas SC.
                </p>

                {{ form_start(form, {
                    attr: {
                        novalidate: 'novalidate'
                    }
                }) }}

                <div class="row g-4">
                    <!-- Imagen y Vista Previa -->
                    <div class="col-md-4 text-center">
                        <div class="mb-3">
                            <img id="previewImagen" class="img-thumbnail rounded-3 mb-2" 
                                src="https://via.placeholder.com/200?text=Sin+Foto" 
                                alt="Vista previa de imagen" 
                                style="width: 200px; height: 200px; object-fit: cover;">

                            {{ form_widget(form.imagen, {
                                attr: {
                                    class: 'form-control',
                                    accept: 'image/*'
                                }
                            }) }}
                            {{ form_errors(form.imagen) }}
                        </div>
                    </div>

                    <!-- Datos del Formulario -->
                    <div class="col-md-8">
                        <div class="mb-3">
                            {{ form_label(form.nombre) }}
                            {{ form_widget(form.nombre, { attr: { class: 'form-control' } }) }}
                            {{ form_errors(form.nombre) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.tipo) }}
                            {{ form_widget(form.tipo, { attr: { class: 'form-control' } }) }}
                            {{ form_errors(form.tipo) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.genero) }}
                            {{ form_widget(form.genero, { attr: { class: 'form-control' } }) }}
                            {{ form_errors(form.genero) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.estado) }}
                            {{ form_widget(form.estado, { attr: { class: 'form-control' } }) }}
                            {{ form_errors(form.estado) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.color) }}
                            {{ form_widget(form.color, { attr: { class: 'form-control' } }) }}
                            {{ form_errors(form.color) }}
                        </div>

                        <div class="text-end mt-4">
                            <button type="submit" class="btn btn-primary px-4">Registrar Mascota</button>
                        </div>
                    </div>
                </div>

                {# Renderiza campos ocultos como el token CSRF (_token) #}
                {{ form_rest(form) }}

                {{ form_end(form, { render_rest: false }) }}

            </div>

        </div>

    </section>

    <!-- Script para vista previa instantánea de la foto -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const inputImagen = document.querySelector('input[type="file"]');
            const previewImagen = document.getElementById('previewImagen');

            if (inputImagen && previewImagen) {
                inputImagen.addEventListener('change', (e) => {
                    const file = e.target.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = (event) => {
                            previewImagen.src = event.target.result;
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }
        });
    </script>

{% endblock %}