{% extends 'base_particular.html.twig' %}

{% block title %}
Registrar tu Mascota | Mascotas SC
{% endblock %}

{% block contenido %}

    <section class="py-5 bg-light min-vh-100 d-flex align-items-center">

        <div class="container my-4">
            <div class="card shadow-lg border-0 rounded-4 p-4">

                <h1 class="text-center mb-4">

                    Registrar Tu Mascota

                </h1>

                <p class="text-muted">

                    Completa tus datos para registrarte tu mascota en el
                    Sistema de Registro de Mascotas SC.

                </p>

                {{ form_start(form, {
                    attr: {
                        novalidate: 'novalidate'
                    }
                }) }}


                <div class="row g-4">
                    <!-- Imagen -->
                    <div class="col-md-4 text-center">
                        <img id="previewImagen" class="img-thumbnail" src="https://via.placeholder.com/200" alt="Vista previa de imagen" style="height: 200px; object-fit: cover;">
                        {{ form_label(form.imagen) }}

                                    {{ form_widget(form.imagen, {
                                        attr: {
                                            class: 'form-control'
                                        }
                                    }) }}

                                    {{ form_errors(form.imagen) }}
                    </div>

                    <!-- Formulario -->
                    <div class="col-md-8">
                        <div class="mb-3 row">
                            <div class="col-12">
                                {{ form_label(form.nombre) }}

                                    {{ form_widget(form.nombre, {
                                        attr: {
                                            class: 'form-control'
                                        }
                                    }) }}

                                    {{ form_errors(form.nombre) }}
                            </div>
                        </div>

                        <div class="mb-3 row">
                            <div class="col-12">
                                {{ form_label(form.tipo) }}

                                    {{ form_widget(form.tipo, {
                                        attr: {
                                            class: 'form-control'
                                        }
                                    }) }}

                                    {{ form_errors(form.tipo) }}
                            </div>
                        </div>

                        <div class="mb-3 row">
                            <div class="col-12">
                                {{ form_label(form.genero) }}

                                    {{ form_widget(form.genero, {
                                        attr: {
                                            class: 'form-control'
                                        }
                                    }) }}

                                    {{ form_errors(form.genero) }}
                            </div>
                        </div>

                        <div class="mb-3 row">
                            <div class="col-12">
                                {{ form_label(form.estado) }}

                                    {{ form_widget(form.estado, {
                                        attr: {
                                            class: 'form-control'
                                        }
                                    }) }}

                                    {{ form_errors(form.estado) }}
                            </div>
                        </div>

                        <div class="mb-3 row">
                            <div class="col-12">
                                {{ form_label(form.color) }}

                                    {{ form_widget(form.color, {
                                        attr: {
                                            class: 'form-control'
                                        }
                                    }) }}

                                    {{ form_errors(form.color) }}
                            </div>
                        </div>

                        <div class="text-end">
                            <button type="submit" class="btn btn-primary px-4">Registrar Mascota</button>
                        </div>
                    </div>
                </div>

                {{ form_end(form) }}
                

            </div>

        </div>

    </section>


{% endblock %}