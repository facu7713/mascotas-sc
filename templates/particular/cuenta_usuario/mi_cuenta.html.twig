{% extends 'base_particular.html.twig' %}

{% block title %}
    Mi Cuenta | Mascotas SC
{% endblock %}

{% block contenido %}

    <section class="py-3">

        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-10">

                    <!-- Encabezado -->
                    <div class="text-center mb-4">

                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="bi bi-check-circle me-2"></i>{{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endfor %}

                        <div class="rounded-circle bg-primary text-white d-inline-flex
                                    justify-content-center align-items-center shadow"
                            style="width: 90px; height: 90px;">

                            <i class="bi bi-person-fill fs-1"></i>

                        </div>

                        <h1 class="fw-bold mt-3">
                            Mi Cuenta
                        </h1>

                        <p class="text-muted">
                            Consultá y administrá la información de tu cuenta.
                        </p>

                    </div>


                    <div class="row g-4">

                        <!-- Datos personales -->
                        <div class="col-md-6">

                            <div class="card shadow-sm border-0 h-100">

                                <div class="card-body p-4">

                                    <h4 class="fw-bold mb-4">

                                        <i class="bi bi-person-vcard me-2"></i>

                                        Datos personales

                                    </h4>


                                    <div class="mb-3">

                                        <small class="text-muted">
                                            Nombre completo
                                        </small>

                                        <p class="fs-5 mb-0">

                                            {{ usuario.persona.nombre }}
                                            {{ usuario.persona.apellido }}

                                        </p>

                                    </div>


                                    <div class="mb-3">

                                        <small class="text-muted">
                                            DNI
                                        </small>

                                        <p class="fs-5 mb-0">

                                            {{ usuario.persona.dni }}

                                        </p>

                                    </div>


                                    <div class="mb-3">

                                        <small class="text-muted">
                                            Dirección
                                        </small>

                                        <p class="fs-5 mb-0">

                                            {{ usuario.persona.direccion }}

                                        </p>

                                    </div>


                                    <div class="mb-0">

                                        <small class="text-muted">
                                            Teléfono
                                        </small>

                                        <p class="fs-5 mb-0">

                                            {{ usuario.persona.telefono }}

                                        </p>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- Datos de la cuenta -->
                        <div class="col-md-6">

                            <div class="card shadow-sm border-0 h-100">

                                <div class="card-body p-4">

                                    <h4 class="fw-bold mb-4">

                                        <i class="bi bi-shield-lock me-2"></i>

                                        Datos de la cuenta

                                    </h4>


                                    <div class="mb-4">

                                        <small class="text-muted">
                                            Correo electrónico
                                        </small>

                                        <p class="fs-5 mb-0">

                                            {{ usuario.email }}

                                        </p>

                                    </div>


                                    <div class="mb-4">

                                        <small class="text-muted">
                                            Rol de usuario
                                        </small>

                                        <p class="mb-0">

                                            {% for rol in usuario.roles %}

                                                {% if rol == 'ROLE_USER' %}

                                                    <span class="badge bg-primary">
                                                        Usuario Particular
                                                    </span>

                                                {% else %}

                                                    <span class="badge bg-secondary">
                                                        {{ rol }}
                                                    </span>

                                                {% endif %}

                                            {% endfor %}

                                        </p>

                                    </div>


                                    <div class="mb-4">

                                        <small class="text-muted">
                                            Contraseña
                                        </small>

                                        <p class="fs-5 mb-0">

                                            <i class="bi bi-key-fill me-2"></i>

                                            ••••••••••

                                        </p>

                                    </div>


                                    <hr class="my-4">


                                    <div class="d-grid gap-2">

                                        <a href="{{ path('app_edit_cuenta') }}"
                                        class="btn btn-primary">

                                            <i class="bi bi-pencil-square me-2"></i>

                                            Editar datos personales

                                        </a>


                                        <a 
                                            href="{{ path('app_cambiar_contrasena') }}" 
                                            class="btn btn-outline-secondary"
                                        >
                                            <i class="bi bi-key me-2"></i>
                                            Cambiar contraseña
                                        </a>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- Información adicional -->
                    <div class="card border-0 shadow-sm mt-4">

                        <div class="card-body p-4">

                            <div class="row align-items-center">

                                <div class="col-md-8">

                                    <h5 class="fw-bold">

                                        <i class="bi bi-heart-fill text-danger me-2"></i>

                                        Tus mascotas registradas

                                    </h5>

                                    <p class="text-muted mb-md-0">

                                        Desde aquí podés acceder a tus mascotas
                                        registradas en el sistema.

                                    </p>

                                </div>


                                <div class="col-md-4 text-md-end mt-3 mt-md-0">

                                    <a href="{{ path('app_tarjeta_id') }}"
                                    class="btn btn-outline-primary">

                                        <i class="bi bi-card-list me-2"></i>

                                        Ver mis mascotas

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>

{% endblock %}
