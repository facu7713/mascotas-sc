{% extends 'base_particular.html.twig' %}

{% block title %}
    Editar Datos Personales | Mascotas SC
{% endblock %}

{% block contenido %}
<section class="py-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">

                <div class="card shadow border-0 rounded-4">
                    <div class="card-body p-4 p-md-5">

                        {# Encabezado visual corregido #}
                        <div class="text-center mb-4">
                            <div class="rounded-circle bg-primary text-white d-inline-flex justify-content-center align-items-center mb-3"
                                style="width: 70px; height: 70px;">
                                <i class="bi bi-person-gear fs-2"></i>
                            </div>

                            <h2 class="fw-bold">Editar datos personales</h2>
                            <p class="text-muted">Modificá tu información de contacto y perfil.</p>
                        </div>

                        {{ form_start(form) }}
                            <div class="row g-3">
                                {# Campos pertenecientes a la entidad Persona #}
                                <div class="col-md-6">
                                    {{ form_label(form.persona.nombre) }}
                                    {{ form_widget(form.persona.nombre) }}
                                    {{ form_errors(form.persona.nombre) }}
                                </div>
                                <div class="col-md-6">
                                    {{ form_label(form.persona.apellido) }}
                                    {{ form_widget(form.persona.apellido) }}
                                    {{ form_errors(form.persona.apellido) }}
                                </div>
                                <div class="col-md-6">
                                    {{ form_label(form.persona.dni) }}
                                    {{ form_widget(form.persona.dni) }}
                                    {{ form_errors(form.persona.dni) }}
                                </div>
                                <div class="col-md-6">
                                    {{ form_label(form.persona.telefono) }}
                                    {{ form_widget(form.persona.telefono) }}
                                    {{ form_errors(form.persona.telefono) }}
                                </div>
                                <div class="col-12">
                                    {{ form_label(form.persona.direccion) }}
                                    {{ form_widget(form.persona.direccion) }}
                                    {{ form_errors(form.persona.direccion) }}
                                </div>

                                {# Campo perteneciente a la entidad User #}
                                <div class="col-12">
                                    {{ form_label(form.email) }}
                                    {{ form_widget(form.email) }}
                                    {{ form_errors(form.email) }}
                                </div>
                            </div>

                            <div class="mt-4 d-flex justify-content-between align-items-center">
                                <a href="{{ path('app_cuenta') }}" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left me-2"></i>Cancelar
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-save me-2"></i>Guardar cambios
                                </button>
                            </div>
                        {{ form_end(form) }}

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>
{% endblock %}