{% extends 'base_particular.html.twig' %}

{% block title %}
    Ser voluntario | Mascotas SC
{% endblock %}

{% block contenido %}

<div class="container py-4">

    <div class="text-center mb-4">

        <i class="bi bi-heart-fill text-primary"
            style="font-size: 3rem;">
        </i>

        <h2 class="fw-bold mt-2">
            Quiero ser voluntario
        </h2>

        <p class="text-muted">
            Ayudá a Mascotas SC y formá parte de nuestra comunidad.
        </p>

    </div>

    {% for message in app.flashes('success') %}

        <div class="alert alert-success alert-dismissible fade show"
            role="alert">

            {{ message }}

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>

    {% endfor %}


    {% if postulante is null %}

        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body p-4">

                <h4 class="fw-bold mb-1">
                    Postulate como voluntario
                </h4>

                <p class="text-muted mb-4">
                    Completá los siguientes datos para enviar tu
                    postulación.
                </p>

                {{ form_start(form) }}

                    <div class="mb-3">
                        {{ form_label(form.motivo) }}
                        {{ form_widget(form.motivo, {
                            'attr': {
                                'class': 'form-control'
                            }
                        }) }}
                        {{ form_errors(form.motivo) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.disponibilidad) }}
                        {{ form_widget(form.disponibilidad, {
                            'attr': {
                                'class': 'form-control'
                            }
                        }) }}
                        {{ form_errors(form.disponibilidad) }}
                    </div>

                    <div class="mb-4">
                        {{ form_label(form.infoAdicional) }}
                        {{ form_widget(form.infoAdicional, {
                            'attr': {
                                'class': 'form-control'
                            }
                        }) }}
                        {{ form_errors(form.infoAdicional) }}
                    </div>

                    <div class="d-flex justify-content-between">

                        <a href="{{ path('app_tarjeta_id') }}"
                            class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-left me-2"></i>
                            Volver

                        </a>

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-send me-2"></i>
                            Enviar postulación

                        </button>

                    </div>

                {{ form_end(form) }}

            </div>

        </div>

    {% else %}

        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body p-4">

                <div class="text-center mb-4">

                    <i class="bi bi-check-circle text-success"
                        style="font-size: 3rem;">
                    </i>

                    <h4 class="fw-bold mt-2">
                        Ya tenés una postulación
                    </h4>

                    <p class="text-muted">
                        No podés realizar otra postulación mientras
                        esta exista.
                    </p>

                </div>

                <div class="mb-3 text-center">

                    <strong>Estado:</strong>

                    <span class="badge bg-warning text-dark ms-2">
                        {{ postulante.estado|upper }}
                    </span>

                </div>

                <div class="mb-3 text-center">

                    <strong>Motivo:</strong>

                    <p class="text-muted mt-1 mb-0">
                        {{ postulante.motivo }}
                    </p>

                </div>

                <div class="mb-3 text-center">

                    <strong>Disponibilidad:</strong>

                    <p class="text-muted mt-1 mb-0">
                        {{ postulante.disponibilidad }}
                    </p>

                </div>

                {% if postulante.infoAdicional %}

                    <div class="mb-4 text-center">

                        <strong>Información adicional:</strong>

                        <p class="text-muted mt-1 mb-0">
                            {{ postulante.infoAdicional }}
                        </p>

                    </div>

                {% endif %}

                <div class="d-flex justify-content-between">

                    <a href="{{ path('app_particular') }}"
                        class="btn btn-primary">

                        <i class="bi bi-arrow-left me-2"></i>
                        Volver

                    </a>

                </div>

            </div>

        </div>

    {% endif %}

</div>

{% endblock %}