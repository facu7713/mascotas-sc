{% extends 'base.html.twig' %}

{% block title %}
Acerca de | Mascotas SC
{% endblock %}

{% block body %}

{% include 'components/header/header_inicio.html.twig' %}

    <!-- HERO -->

    <section class="py-5 bg-light">

        <div class="container">

            <div class="row align-items-center">

                <div class="col-lg-6">

                    <h1 class="display-4 fw-bold text-primary">

                        Acerca de Mascotas SC

                    </h1>

                    <p class="lead mt-4">

                        Tecnología al servicio del bienestar animal.

                    </p>

                    <p>

                        Una plataforma diseñada para facilitar
                        el registro, identificación y gestión
                        responsable de mascotas mediante
                        herramientas digitales modernas.

                    </p>

                </div>

                <div class="col-lg-6 text-center">

                    <img
                        src="{{ asset('imagenes_pagina/logo-escritorio.png') }}"
                        class="img-fluid"
                        alt="Mascotas SC">

                </div>

            </div>

        </div>

        </section>

        <!-- VISIÓN -->

        <section class="py-5">


        <div class="container">

            <div class="row justify-content-center">

                <div class="col-lg-10">

                    <h2 class="fw-bold text-center mb-4">

                        Nuestra Visión

                    </h2>

                    <p class="text-center fs-5">

                        Creemos que la tecnología puede convertirse
                        en una herramienta fundamental para fortalecer
                        el vínculo entre las personas y sus mascotas.

                    </p>

                    <p class="text-center">

                        Mascotas SC nace con el objetivo de brindar
                        una solución moderna que facilite la
                        identificación, administración y protección
                        de los animales de compañía.

                    </p>

                </div>

            </div>

        </div>

        </section>

        <!-- PROBLEMA -->

        <section class="py-5 bg-light">


        <div class="container">

            <h2 class="fw-bold text-center mb-5">

                El problema que buscamos resolver

            </h2>

            <div class="row">

                <div class="col-lg-8 mx-auto text-center">

                    <p>

                        Miles de mascotas se extravían cada año
                        y muchas veces no cuentan con mecanismos
                        de identificación que permitan localizar
                        rápidamente a sus responsables.

                    </p>

                    <p>

                        Además, la información relacionada con
                        vacunas, registros y datos de contacto
                        suele encontrarse dispersa o desactualizada.

                    </p>

                    <p>

                        Esta situación genera dificultades para
                        propietarios, voluntarios y organizaciones
                        que buscan colaborar con el bienestar animal.

                    </p>

                </div>

            </div>

        </div>

        </section>

        <!-- SOLUCIÓN -->

        <section class="py-5">

        <div class="container">

            <h2 class="fw-bold text-center mb-5">

                Nuestra Solución

            </h2>

            <div class="row">

                <div class="col-md-4 mb-4">

                    <div class="card h-100 border-0 shadow">

                        <div class="card-body text-center">

                            <h3 class="mb-3">📋</h3>

                            <h4>Registro Centralizado</h4>

                            <p>

                                Toda la información de la mascota
                                organizada en un único sistema.

                            </p>

                        </div>

                    </div>

                </div>

                <div class="col-md-4 mb-4">

                    <div class="card h-100 border-0 shadow">

                        <div class="card-body text-center">

                            <h3 class="mb-3">🏷️</h3>

                            <h4>Identificación Digital</h4>

                            <p>

                                Generación de tarjetas y códigos QR
                                para facilitar la identificación.

                            </p>

                        </div>

                    </div>

                </div>

                <div class="col-md-4 mb-4">

                    <div class="card h-100 border-0 shadow">

                        <div class="card-body text-center">

                            <h3 class="mb-3">🤝</h3>

                            <h4>Colaboración Comunitaria</h4>

                            <p>

                                Participación activa de ciudadanos,
                                voluntarios y administradores.

                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        </section>

        <!-- BENEFICIOS -->

        <section class="py-5 bg-light">


        <div class="container">

            <h2 class="fw-bold text-center mb-5">

                Beneficios del Sistema

            </h2>

            <div class="row">

                <div class="col-lg-5 mx-auto">

                    <ul class="list-group list-group-flush fs-5">

                        <li class="list-group-item">
                            ✓ Registro digital seguro de mascotas
                        </li>

                        <li class="list-group-item">
                            ✓ Información organizada y accesible
                        </li>

                        <li class="list-group-item">
                            ✓ Historial de vacunación
                        </li>

                        <li class="list-group-item">
                            ✓ Tarjetas de identificación
                        </li>

                        <li class="list-group-item">
                            ✓ Generación de códigos QR
                        </li>

                        <li class="list-group-item">
                            ✓ Reportes de mascotas perdidas o encontradas
                        </li>

                    </ul>

                </div>

            </div>

        </div>

        </section>

        <!-- PRINCIPIOS -->

        <section class="py-5">

        <div class="container">

            <h2 class="fw-bold text-center mb-5">

                Nuestros Principios

            </h2>

            <div class="row text-center ">

                <div class="col-md-3 mb-3 ">

                    <div class="card border-0 shadow-sm bg-black text-light">

                        <div class="card-body ">

                            <h5>Transparencia</h5>

                            <p class="mt-3 mb-0"> Promovemos una gestión clara, accesible y responsable de la información registrada en el sistema. </p>

                        </div>

                    </div>

                </div>

                <div class="col-md-3 mb-3">

                    <div class="card border-0 shadow-sm bg-black text-light">

                        <div class="card-body">

                            <h5>Compromiso</h5>

                            <p class="mt-3 mb-0"> Trabajamos para fomentar el cuidado responsable y el respeto hacia las mascotas y la comunidad. </p>

                        </div>

                    </div>

                </div>

                <div class="col-md-3 mb-3">

                    <div class="card border-0 shadow-sm bg-black text-light">

                        <div class="card-body">

                            <h5>Responsabilidad</h5>

                            <p class="mt-3 mb-0"> Impulsamos el uso adecuado de la información para favorecer la protección y el bienestar animal. </p>

                        </div>

                    </div>

                </div>

                <div class="col-md-3 mb-3">

                    <div class="card border-0 shadow-sm bg-black text-light">

                        <div class="card-body">

                            <h5>Innovación</h5>

                            <p class="mt-3 mb-0"> Aprovechamos herramientas digitales modernas para facilitar la identificación y gestión de mascotas. </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        </section>

        <!-- IMPACTO -->

        <section class="py-5 bg-primary text-white">


        <div class="container text-center">

            <h2 class="fw-bold">

                Nuestro Impacto

            </h2>

            <p class="mt-4 fs-5">

                Mascotas SC busca convertirse en una herramienta
                que contribuya al cuidado responsable de las mascotas,
                facilite su identificación y fortalezca la colaboración
                entre los miembros de la comunidad.

            </p>

            <p class="mt-4">

                Una mascota identificada tiene más posibilidades
                de regresar a casa.

            </p>

            <a href="{{ path('app_inicio') }}"
                class="btn btn-light btn-lg mt-3">

                <i class="bi bi-box-arrow-in-left"></i> Volver al Inicio

            </a>

        </div>


    </section>

{% include 'components/footer/footer_inicio.html.twig' %}

{% endblock %}

